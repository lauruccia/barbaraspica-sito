# =============================================================
# .htaccess - barbaraspica.it
# Sicurezza, redirect, performance per cPanel/Apache
# =============================================================

# ---- Default charset ----
AddDefaultCharset UTF-8

# ---- Rewrite engine ----
RewriteEngine On

# ---- Forza HTTPS ----
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ---- Forza dominio senza www ----
RewriteCond %{HTTP_HOST} ^www\.barbaraspica\.it [NC]
RewriteRule ^(.*)$ https://barbaraspica.it/$1 [R=301,L]

# ---- Pagina 404 personalizzata ----
ErrorDocument 404 /404.html

# ---- URL puliti: rimuove .html dall'URL ----
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internamente serve il .html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ---- Redirect dal vecchio sito WordPress ----
Redirect 301 /la-relazione-come-punto-di-partenza/ /approccio.html
Redirect 301 /la-relazione-come-punto-di-partenza /approccio.html

# ---- URL trailing slash: rimuovi slash finale ----
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ---- Sicurezza: blocca accesso a file sensibili ----
<FilesMatch "(^\.|composer\.(json|lock)|package(-lock)?\.json|.*\.(bat|sh|py|md))$">
  Require all denied
</FilesMatch>

# Blocca cartelle sorgente
RedirectMatch 403 ^/_articles(/.*)?$
RedirectMatch 403 ^/_tools(/.*)?$
RedirectMatch 403 ^/\.contact-rate\.log$

# Disabilita listing directory
Options -Indexes

# ---- Security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---- Compressione gzip ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml font/ttf font/otf application/font-woff application/font-woff2
</IfModule>

# ---- Cache headers ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# ---- MIME types ----
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# ---- PHP: nessun errore in produzione ----
<IfModule mod_php.c>
  php_flag display_errors off
  php_flag log_errors on
</IfModule>
